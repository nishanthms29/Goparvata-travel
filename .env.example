# Required: MySQL/MariaDB connection reachable by the app and Prisma migrations.
# Percent-encode reserved characters in the username/password.
DATABASE_URL="mysql://APP_USER:URL_ENCODED_PASSWORD@DB_HOST:3306/travel_agency"

# Required in production: generate a unique random secret (at least 32 random bytes).
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"

# Required in production: canonical public origin, with scheme and no trailing slash.
APP_URL="https://www.example.com"

# Optional: SMTP notifications for submitted enquiries.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="GOPARVATA <no-reply@example.com>"
ENQUIRY_TO_EMAIL="travel-team@example.com"

# Optional: Google Maps browser key; restrict it to the production website origin.
NEXT_PUBLIC_MAPS_API_KEY=""

# Optional: business contact details. WhatsApp number uses country code and digits only.
WHATSAPP_BUSINESS_NUMBER=""
BUSINESS_EMAIL="travel-team@example.com"
BUSINESS_PHONE=""
